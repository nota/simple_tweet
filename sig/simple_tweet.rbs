module SimpleTweet
  VERSION: String

  module V2
    module ResponseParser
      def self?.data_of: (Net::HTTPResponse res, String error_kind_message) -> Hash[String, untyped]
      def self?.ensure_no_errors: (Net::HTTPResponse res, String error_kind_message) -> void
      def self?.media_id_from: (Hash[String, untyped] data, Net::HTTPResponse res) -> String
      def self?.parsed_body: (Net::HTTPResponse res, String error_kind_message, ?allow_empty: bool) -> Hash[String, untyped]
      def self?.error_message: (Net::HTTPResponse res, String error_kind_message) -> String
    end

    class Client
      TW_API_ORIGIN: String
      TW_MEDIA_UPLOAD_PATH: String
      TW_MEDIA_INITIALIZE_PATH: String
      TW_MEDIA_METADATA_PATH: String
      TW_TWEET_PATH: String
      UA: String
      APPEND_PER: Integer
      SUCCESS_STATUS_CODE: Regexp
      RETRYABLE_STATUS_CODE: Regexp
      VIDEO_MEDIA_TYPE: String
      MEDIA_TYPE_ALIASES: Hash[String, String]
      MEDIA_CATEGORIES: Hash[String, String]
      DEFAULT_MEDIA_CATEGORY: String
      PROCESSING_STATES: Array[String]
      DEFAULT_CHECK_AFTER_SECS: Integer
      MIN_CHECK_AFTER_SECS: Integer

      def initialize: (consumer_key: String, consumer_secret: String, access_token: String, access_token_secret: String, ?max_append_retry: Integer) -> void
      def tweet: (message: String, ?media_ids: Array[String]) -> Net::HTTPResponse
      def tweet_with_media: (message: String, media_type: String, media: untyped, ?alt_text: String?) -> Net::HTTPResponse

      @consumer_key_: String
      @consumer_secret_: String
      @access_token_: String
      @access_token_secret_: String
      @max_append_retry_: Integer
      @client: untyped # ::OAuth::AccessToken

      private
      def access_token: () -> untyped
      def request: (Net::HTTPRequest req) -> Net::HTTPResponse
      def request_with_retry: (req: Net::HTTPRequest, error_kind_message: String, ?expected_status_code: String | Regexp, ?retry_count: Integer) -> Net::HTTPResponse
      def normalize_media_type: (String media_type) -> String
      def media_category: (String media_type) -> String
      def json_request: (String path, Hash[Symbol, untyped] body) -> Net::HTTP::Post
      def check_after_secs: (Hash[String, untyped] processing_info) -> Numeric
      def upload_media: (media_type: String, media: untyped) -> [String]
      def init: (video: untyped, ?media_type: String) -> String
      def append: (video: untyped, media_id: String, index: untyped) -> Net::HTTPResponse
      def finalize: (media_id: String) -> Hash[String, untyped]
      def status: (media_id: String) -> Hash[String, untyped]
      def upload_video: (video: untyped, ?media_type: String) -> [String]
      def wait_for_processing: (media_id: String, processing_info: Hash[String, untyped]?) -> void
      def create_media_metadata: (media_id: String, alt_text: String?) -> Net::HTTPResponse
    end
  end

  class Error < StandardError
  end

  class UploadMediaError < Error
    attr_reader response: Net::HTTPResponse?
    def initialize: (?String? message, ?response: Net::HTTPResponse?) -> void
  end
end
